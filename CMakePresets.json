{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows x64 (Visual Studio 2022)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows",
      "cacheVariables": { "DPTDOOM_BACKEND": "win32" }
    },
    {
      "name": "windows-sdl",
      "inherits": "windows",
      "displayName": "Windows x64 SDL2 + audio (run tools/fetch-sdl.ps1 first)",
      "binaryDir": "${sourceDir}/build/windows-sdl",
      "cacheVariables": {
        "DPTDOOM_BACKEND": "sdl",
        "DPTDOOM_SOUND": "ON",
        "DPTDOOM_STATIC_CRT": "ON",
        "SDL2_DIR": "${sourceDir}/build/deps/SDL2-2.32.10/cmake",
        "SDL2_mixer_DIR": "${sourceDir}/build/deps/SDL2_mixer-2.8.2/cmake"
      }
    },
    {
      "name": "windows-headless",
      "inherits": "windows",
      "binaryDir": "${sourceDir}/build/windows-headless",
      "cacheVariables": { "DPTDOOM_BACKEND": "headless" }
    },
    {
      "name": "windows-asan",
      "inherits": "windows-headless",
      "displayName": "Windows x64 MSVC AddressSanitizer (headless)",
      "binaryDir": "${sourceDir}/build/windows-asan",
      "cacheVariables": { "DPTDOOM_SANITIZER": "address", "DPTDOOM_LTO": "OFF" }
    },
    {
      "name": "headless",
      "displayName": "Headless (Ninja, compiler from environment)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/headless",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "DPTDOOM_BACKEND": "headless" }
    }
  ],
  "buildPresets": [
    { "name": "windows", "configurePreset": "windows", "configuration": "Release" },
    { "name": "windows-asan", "configurePreset": "windows-asan", "configuration": "RelWithDebInfo" },
    { "name": "windows-sdl", "configurePreset": "windows-sdl", "configuration": "Release" },
    { "name": "windows-headless", "configurePreset": "windows-headless", "configuration": "Release" },
    { "name": "headless", "configurePreset": "headless" }
  ],
  "testPresets": [
    { "name": "windows", "configurePreset": "windows", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "windows-asan", "configurePreset": "windows-asan", "configuration": "RelWithDebInfo", "environment": { "ASAN_OPTIONS": "halt_on_error=1:detect_leaks=0" }, "output": { "outputOnFailure": true } },
    { "name": "windows-sdl", "configurePreset": "windows-sdl", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "windows-headless", "configurePreset": "windows-headless", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "headless", "configurePreset": "headless", "output": { "outputOnFailure": true } }
  ]
}
